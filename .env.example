# ── Job-hunter MCP — environment variables ───────────────────────────────────
# Copy to .env for local HTTP testing (never commit .env). On Cloud Run, set
# these as service env vars / secrets instead.

# Transport: "stdio" (default, local desktop) or "http" (remote server)
MCP_TRANSPORT=http

# Port for the HTTP transport (Cloud Run injects PORT automatically)
PORT=3001

# ── Auth (HTTP transport only) ───────────────────────────────────────────────
# Strong shared secret the client must present as a bearer token.
# Generate with:  openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-a-long-random-secret

# ── Config & secrets (hosted deploys: no files on disk) ──────────────────────
# Full config object (preferences, cv_text, google_sheets.spreadsheet_id, …) as
# a single-line JSON string. See config.example.json for the shape. For hosted
# use, include "cv_text" so no CV file is needed.
JOB_HUNTER_CONFIG_JSON={"google_sheets":{"spreadsheet_id":"..."},"preferences":{},"cv_text":"..."}

# The Google service-account key JSON as a single-line string (store in a secret
# manager, not here). This is the file you download from Google Cloud.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Optional — only needed to AUTO-CREATE Google Docs (a service account can't).
# The OAuth client_id/client_secret + the refresh_token from `npm run auth`,
# as a single-line JSON string. Docs get created in your own Drive, owned by you.
# GOOGLE_OAUTH_JSON={"client_id":"...","client_secret":"...","refresh_token":"..."}

# Optional individual overrides (take precedence over JOB_HUNTER_CONFIG_JSON):
# SPREADSHEET_ID=
# CV_FILE_PATH=
# DOCS_FOLDER_ID=
